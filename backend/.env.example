# Copia este archivo como .env y agrega la clave de tu aplicación.
# https://openchargemap.org (Mi perfil > Mis aplicaciones)
OCM_API_KEY=
PORT=3001
# Sin clave, la lista utiliza OpenStreetMap. Para ejemplos: OCM_DEMO=true
OCM_DEMO=false

# URL del frontend para cookies y solicitudes
APP_URL=http://localhost:3000
# Base SQLite persistente, relativa al directorio del backend
APP_DB_PATH=data/app.sqlite

